# Ollama runs outside this Compose project.
OLLAMA_BASE_URL=http://host.docker.internal:11434
# 必須: pull 済みのモデル名
OLLAMA_MODEL=
OLLAMA_VISION_ENABLED=true

# Ancilla tool and local port settings.
ANCILLA_TOOL_MODE=native
ANCILLA_API_PUBLISHED_PORT=8765
ANCILLA_WS_PUBLISHED_PORT=8766
ANCILLA_API_BIND_ADDRESS=127.0.0.1
ANCILLA_WS_BIND_ADDRESS=127.0.0.1

# Optional integrations.
# WEB_SEARCH_PROVIDER=searxng
# BRAVE_API_KEY=
# TAVILY_API_KEY=
# SEARXNG_URL=http://host.docker.internal:8080
# SEARXNG_TOKEN=
# DISCORD_BOT_TOKEN=
# DISCORD_NOTIFY_USER_ID=
